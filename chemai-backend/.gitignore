env/
ENV/

# ===== 环境变量与密钥 =====
# .env 里含 JWT_SECRET_KEY、数据库口令、模型 API Key，绝对不能进版本库。
# .env.example 是模板，需要提交（用 ! 显式放行）。
.env
.env.*
!.env.example

# ===== 数据库 =====
# 本地开发用 SQLite 文件库，属于开发者机器上的状态，不入库。
*.db
*.db-journal
*.sqlite
*.sqlite3
chemai.db

