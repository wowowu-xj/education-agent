# ChemAI 后端环境配置模板
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，真实密钥绝不提交）。
# 变量名必须全大写、与环境变量名逐字一致（config.py 用 case_sensitive=True，
# 写成小写会静默失效，回落到代码库默认占位值）。

# ---- 运行环境 ----
# dev：本地开发；test：自动化测试；prod：生产（会强校验密钥、关闭 API 文档）
APP_ENV=dev
APP_NAME=ChemAI
DEBUG=false

# ---- 数据库 ----
DATABASE_URL=sqlite:///./chemai.db

# ---- JWT ----
# 本地开发可留空（沿用代码库占位密钥）；生产必须换成真实随机密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# 逗号分隔的允许来源；留空表示同源部署（不注册 CORS 中间件）
CORS_ORIGINS=

# ---- 向量检索 / 相似题推荐 ----
# ChromaDB 持久化目录（已加入 .gitignore）
CHROMA_DB_PATH=./chroma_db
# 通义千问 DashScope 文本嵌入 API Key（text-embedding-v3）。
# 留空 → 相似题退化为 MD5 伪向量 / 关键词降级（无语义相似度）。
DASHSCOPE_API_KEY=
# 嵌入向量维度（与 DashScope text-embedding-v3 输出一致）
EMBEDDING_DIMENSION=1024
